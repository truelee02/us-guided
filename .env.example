# Copy this file to .env and fill in real values. Never commit .env.

# Gemini API key (from Google AI Studio). If left empty, the server runs in
# STUB mode: AI responses are canned/deterministic so every flow still works.
GEMINI_API_KEY=

# Port the server listens on.
PORT=3000

# Where the app's data file lives. Leave unset for local use (./data).
# On Render this is set to /var/data so data sits on the persistent disk
# and survives restarts and redeploys.
DATA_DIR=

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string
