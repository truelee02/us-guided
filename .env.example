# Copy this file to .env and fill in real values. Never commit .env.

# Gemini API key (from Google AI Studio). If left empty, the server runs in
# STUB mode: AI responses are canned/deterministic so every flow still works.
GEMINI_API_KEY=

# Port the server listens on.
PORT=3000

# Where the app's data file lives. Leave unset for local use (./data).
# On Render this is set to /var/data so data sits on the persistent disk
# and survives restarts and redeploys.
DATA_DIR=

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Public address of the app, used to build password-reset links.
# Defaults to https://usguided.com when unset in production.
APP_URL=https://usguided.com

# Resend API key for sending password-reset emails. If left empty, reset
# links are written to the server log instead of emailed (fine while the
# owner runs the app for testers she knows).
RESEND_API_KEY=

# Sender for outgoing mail, e.g. Us, Guided <support@usguided.com>.
# The domain must be verified in Resend before this works.
MAIL_FROM=

# Optional owner-operations secret. When set, requests carrying the header
# "x-admin-secret: <this value>" can download a backup copy of the data
# file (GET /api/admin/backup), force a snapshot (POST /api/admin/snapshot),
# and reset a locked-out user's password (POST /api/admin/reset-password).
# Leave empty to disable those routes entirely.
ADMIN_SECRET=
